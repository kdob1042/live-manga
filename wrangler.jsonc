{
  "name": "live-manga",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-16",
  // Keep the Worker off workers.dev. Public access is controlled by the
  // Cloudflare Access application and its dashboard-managed hostname/route.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/releases/*", "/catalog.json"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "live-manga-media-prod"
    }
  ]
}
