{
  "name": "live-manga",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-16",
  // Keep workers.dev enabled: Cloudflare Access limits this publication URL.
  // Setting this to false disables the route on the next redeploy.
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLICATION_CATALOG_KEY": "publication/catalog.json",
    // Keep the legacy catalog fallback until the publication catalog is installed.
    // Set this to "true" as part of the controlled production cutover.
    "REQUIRE_PUBLICATION_CATALOG": "false"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/releases/*", "/works/*", "/catalog.json"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "live-manga-media-prod"
    }
  ]
}
