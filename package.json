{
  "name": "live-manga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/materialize-demo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/materialize-demo.mjs && vite build",
    "pretest": "node scripts/materialize-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "verify:deploy-config": "node scripts/verify-deploy-config.mjs",
    "contract:bundle": "node scripts/contract-bundle.mjs",
    "fixture:generate": "node scripts/fixture.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "^7.0.0"
  }
}
